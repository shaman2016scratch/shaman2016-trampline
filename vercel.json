{
  "version": 2,
  "builds": [
    {
      "src": "api/scratch.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/github.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/penguinmod.mjs",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/scratch/(.*)",
      "dest": "/api/scratch.mjs?path=$1"
    },
    {
      "src": "/github/(.*)",
      "dest": "/api/github.mjs?path=$1"
    },
    {
      "src": "/penguinmod/(.*)",
      "dest": "/api/penguidmod.mjs?path=$1"
    }
  ]
}
