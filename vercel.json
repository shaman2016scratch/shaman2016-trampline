{
  "version": 2,
  "builds": [
    {
      "src": "api/scratch.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/github.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/penguinmod.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/url.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/telegram.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/dash.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/dashAvatar.mjs",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/scratch/(.*)",
      "dest": "/api/scratch.mjs?path=$1"
    },
    {
      "src": "/github/(.*)",
      "dest": "/api/github.mjs?path=$1"
    },
    {
      "src": "/penguinmod/(.*)",
      "dest": "/api/penguinmod.mjs?path=$1"
    },
    {
      "src": "/other/(.*)",
      "dest": "/api/url.mjs?url=$1"
    },
    {
      "src": "/tg/(.*)",
      "dest": "/api/telegram.mjs?path=$1"
    },
    {
      "src": "/dash/(.*)",
      "dest": "/api/dash.mjs?path=$1"
    },
    {
      "src": "/dashImage/(.*)",
      "dest": "/api/dashAvatar.mjs?path=$1"
    }
  ]
}
