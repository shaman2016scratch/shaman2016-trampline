{
  "version": 2,
  "builds": [
    {
      "src": "api/scratch.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/github.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/penguinmod.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/url.mjs",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/scratch/(.*)?(.*)",
      "dest": "/api/scratch.mjs?path=$1&url_params=$2"
    },
    {
      "src": "/github/(.*)?(.*)",
      "dest": "/api/github.mjs?path=$1&url_params=$2"
    },
    {
      "src": "/penguinmod/(.*)?(.*)",
      "dest": "/api/penguinmod.mjs?path=$1&url_params=$2"
    },
    {
      "src": "/other/(.*)?(.*)",
      "dest": "/api/url.mjs?url=$1&params=$2"
    }
  ]
}
